# Environment variables read by Forkyard (core, app, helpers, scripts).
# Names and explanations only – no values belong here.
#
# Normal use needs NONE of them. A release build only honours FORKYARD_DATA_DIR, FORKYARD_GIT_PATH
# and FORKYARD_SSH_DIR; everything marked “debug build only” has no effect there. Host account
# tokens and proxy passwords are never read from the environment or a file: they are entered in the
# app and stored only in the operating system's keychain.

# --- App (src-tauri) -------------------------------------------------------------------

# Data directory (database, instance.json) instead of the one the OS assigns to the app.
FORKYARD_DATA_DIR=
# Fixed path to Git instead of searching PATH; a path that does not exist gives the “Git missing” state.
FORKYARD_GIT_PATH=
# Debug build only: keychain service name (default: forkyard), so test runs don't mix their entries with real ones.
FORKYARD_KEYRING_SERVICE=
# Debug build only: avatar service instead of GitHub; “off” turns avatar lookups off.
FORKYARD_AVATAR_URL=
# Debug build only: address of the Vite server the window loads the UI from.
FORKYARD_DEV_URL=
# Debug build only, set by the E2E driver: “hidden” does not show the window, “visible” does.
FORKYARD_E2E_WINDOW=
# Debug build only: inner window size in physical pixels, e.g. 1440x900.
FORKYARD_WINDOW_SIZE=

# --- Core (crates/core) ----------------------------------------------------------------

# SSH folder instead of ~/.ssh (generate and import keys, known_hosts).
FORKYARD_SSH_DIR=
# Debug build only: fixed path to the prompt helper for Git and SSH (forkyard-askpass) instead of looking next to the app.
FORKYARD_ASKPASS_PATH=
# Debug build only: fixed path to the helper Git starts as sequence editor during interactive rebase.
FORKYARD_EDITOR_HELPER=

# --- Set by the core for its own child processes (do not set by hand) -------------------

# Port of the local channel forkyard-askpass uses to pass a prompt to the core.
FORKYARD_ASKPASS_PORT=
# One-time token for that channel; valid for a single Git call only.
FORKYARD_ASKPASS_TOKEN=
# Path of the prepared todo file; when set, the program acts as sequence editor and exits.
FORKYARD_SEQUENCE_TODO=
# Folder with the repository's real hooks, called by the app's hook wrapper.
FORKYARD_HOOK_REAL=
# Folder the hook wrapper writes the hooks' output and exit code to.
FORKYARD_HOOK_LOG=

# --- Tests and scripts -----------------------------------------------------------------

# Port of the Vite server for E2E runs (vite.config.ts); the driver sets it itself.
FORKYARD_E2E_PORT=
# cargo test (crates/askpass): test a different helper than the one cargo built, e.g. the sidecar from the bundle.
FORKYARD_TEST_HELPER=
# Set by the WebDriver harness (scripts/e2e-wd) for its Vite server: puts the page error hook in front of the app.
FORKYARD_E2E_ERROR_HOOK=
# WebDriver harness: folder with locally unpacked tools (usr/bin/Xvfb, usr/bin/WebKitWebDriver, usr/lib/…) used when they are not on PATH.
E2E_TOOLS_ROOT=
# WebDriver harness: explicit paths to tauri-driver, the native WebDriver (WebKitWebDriver/msedgedriver) and Xvfb.
E2E_TAURI_DRIVER=
E2E_NATIVE_DRIVER=
E2E_XVFB=
# WebDriver harness, set by run.mjs: the app copy every feature of a run uses; feature name; scenario filter.
E2E_WD_APP=
E2E_WD_FEATURE=
E2E_WD_ONLY=
# E2E driver: “1” prints where the time goes when a test instance starts.
GC_E2E_TRACE=
# E2E fixtures: “0” rebuilds the test repositories every time instead of copying them from the temp cache.
GC_FIXTURE_CACHE=
