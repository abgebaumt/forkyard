{
  "name": "forkyard",
  "private": true,
  "version": "1.3.0",
  "description": "Fast, local Git client for the desktop: commit graph, line staging, merge tool, interactive rebase and Undo for Git. No account, no telemetry.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/abgebaumt/forkyard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abgebaumt/forkyard.git"
  },
  "bugs": {
    "url": "https://github.com/abgebaumt/forkyard/issues"
  },
  "keywords": [
    "git",
    "git-client",
    "git-gui",
    "desktop",
    "tauri",
    "rust",
    "react",
    "commit-graph",
    "merge-tool",
    "version-control"
  ],
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-tokens.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "test": "vitest run",
    "check:commands": "node scripts/check-commands.mjs",
    "check:case": "node scripts/check-case.mjs",
    "test:scripts": "node --test scripts/error-codes.test.mjs scripts/check-commands.test.mjs",
    "e2e:wd:prepare": "node e2e/prepare.mjs",
    "e2e:wd": "node e2e/run.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "npm run typecheck && npm test && npm run test:scripts && npm run check:commands && npm run check:case && npm run check:contrast && npm run lint"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "i18next": "^26.4.4",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "node-diff3": "^3.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
