{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "scripts/**", "*.ts", "!scripts/e2e/**", "!src/styles/tokens.css", "!src/styles/theme.css"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": { "useDomNodeTextContent": "off" },
      "style": { "noNonNullAssertion": "off" },
      "a11y": {
        "useSemanticElements": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "useAriaPropsSupportedByRole": "off",
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noTemplateCurlyInString": "off",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off"
      },
      "complexity": { "noCommaOperator": "off" },
      "correctness": { "useExhaustiveDependencies": "off" }
    }
  },
  "assist": { "enabled": false }
}
